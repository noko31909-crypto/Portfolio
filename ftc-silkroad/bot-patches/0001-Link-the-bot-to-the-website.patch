+def website_kb(text: str = "🌐 Open the website", listing_id: int | None = None) -> InlineKeyboardMarkup | None:
+    url = site_link(listing_id)
+    if not url:
+        return None
+    return InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text=text, url=url)]])
 
 
